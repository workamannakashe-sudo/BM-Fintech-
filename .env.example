# ==============================================================================
# BUDGETMITRA ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or secret production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed in Browser Bundle)
# Only public, read-restricted or anon keys belong here.
# ------------------------------------------------------------------------------

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Publishable Key (RLS protects database tables)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ENVIRONMENT VARIABLES (Vercel Serverless Functions / /api/*)
# Keep strictly private! Never prefix with VITE_.
# Set these in your Vercel Project Settings -> Environment Variables.
# ------------------------------------------------------------------------------

# Google Gemini API Key (Used by /api/chat and /api/receipt)
# Generates structured AI advice, receipt extraction, and multi-turn coaching
GEMINI_API_KEY=your_google_gemini_api_key_here

# Supabase Service Role Key (Optional: for administrative backend jobs only)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. ROTATION INSTRUCTIONS
# ------------------------------------------------------------------------------
# If an API key was previously exposed via VITE_GEMINI_API_KEY:
# 1. Open Google AI Studio (https://aistudio.google.com/app/apikey).
# 2. Delete the exposed key and create a new API Key.
# 3. Add the new key ONLY as GEMINI_API_KEY in Vercel settings and .env.local.
# 4. Remove any VITE_GEMINI_API_KEY from Vercel build settings.
